  "narrative": {
    "overview": "This is a scan of the implemented website, not a new identity. ASMA red, warm off-white surfaces, bold Lato headings, Montserrat reading text, and italic Playfair Display accents connect the homepage, member directory, calendar, and teaching-material archive. The homepage gives the existing group portrait and moving background the largest visual role; reading surfaces use quieter backgrounds and clear divisions.\n\nThe material directory extends that vocabulary with left-aligned headings, search, wrapping cohort controls, phase navigation, and lists of source titles. Member archives reuse the incumbent portrait-card grid while preserving the original square photographs. No new creative metaphor or brand commitment is established by this documentation.",
    "keyCharacteristics": [
      "Warm paper surfaces with red actions and deep red text.",
      "Bold sans-serif headings paired with italic serif accents.",
      "Rounded controls and portrait cards; flat, divided material rows.",
      "Photographic identity on the homepage and member pages."
    ],
    "rules": [],
    "dos": [
      "Do reuse the ASMA palette, font roles, shared container, and existing controls.",
      "Do keep material titles and member names readable and able to wrap.",
      "Do preserve full square archive photographs and their source records.",
      "Do provide keyboard focus, semantic selection states, and reduced-motion behavior.",
      "Do keep material availability and external-source permissions visible."
    ],
    "donts": [
      "Don't replace the homepage identity while extending the archive.",
      "Don't crop or zoom archive photographs to imitate current-member portraits.",
      "Don't render unavailable material titles as active links.",
      "Don't turn the material list into an image-card gallery or embed every video automatically.",
      "Don't promote page-specific layout decisions into universal brand rules."
    ]
  }
